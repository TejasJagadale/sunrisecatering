# Public site URL used for canonical links, Open Graph tags, JSON-LD, sitemap.xml and robots.txt.
# Replace with the real domain before deploying (no trailing slash).
VITE_SITE_URL=https://www.your-domain.example

# Optional: a form service endpoint (Formspree, Web3Forms, your own API ...).
# Leave empty to keep the enquiry form in clearly-labelled demo mode.
VITE_FORM_ENDPOINT=
